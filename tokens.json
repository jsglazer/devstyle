{
  "version": "1.0.0",
  "prefix": "--ds-",
  "types": {
    "color": "#rgb, #rrggbb, #rrggbbaa, rgb() or rgba(). Named colours and color-mix() are not allowed, so native apps can read every value.",
    "px": "A length in px, e.g. 13px.",
    "number": "A plain number, e.g. 1.5.",
    "font": "A comma-separated font-family list. Native apps map -apple-system / system-ui to the system font and ui-monospace / 'SF Mono' to the system monospaced font.",
    "shadow": "A CSS box-shadow. Web only: native apps ignore it.",
    "filter": "A CSS filter, or none. Web only: native apps ignore it."
  },
  "tokens": [
    { "name": "bg", "group": "surface", "type": "color", "description": "Main window background" },
    { "name": "panel", "group": "surface", "type": "color", "description": "Toolbars, tab strips, sidebars, status bar" },
    { "name": "raised", "group": "surface", "type": "color", "description": "Cards, popovers, modal dialogs" },
    { "name": "border", "group": "surface", "type": "color", "description": "Dividers and control borders" },
    { "name": "overlay", "group": "surface", "type": "color", "description": "Backdrop behind modal dialogs" },

    { "name": "fg", "group": "text", "type": "color", "description": "Primary text" },
